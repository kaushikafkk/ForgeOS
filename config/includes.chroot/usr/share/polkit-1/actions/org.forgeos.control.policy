<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ForgeOS</vendor>
  <vendor_url>https://github.com/kaushikafkk/ForgeOS</vendor_url>
  <action id="org.forgeos.control.inspect">
    <description>Inspect ForgeOS system state</description>
    <message>Authentication is required to inspect protected ForgeOS state</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
