#!/usr/bin/python3
from __future__ import annotations

import json
import socket
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk


SOCKET_PATH = "/run/forgeos/forged.sock"
API_VERSION = "forgeos.dev/v1"
CSS_PATH = "/usr/share/forgeos/forge-hub.css"


def daemon_status() -> dict:
    request = {"version": API_VERSION, "action": "status.read"}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(1.5)
            client.connect(SOCKET_PATH)
            client.sendall((json.dumps(request) + "\n").encode())
            response = b""
            while not response.endswith(b"\n") and len(response) < 65536:
                part = client.recv(4096)
                if not part:
                    break
                response += part
        payload = json.loads(response.decode())
        if payload.get("ok"):
            return payload["data"]
    except (OSError, ValueError, KeyError):
        pass
    return {
        "product": "ForgeOS",
        "release": "0.1-dev",
        "mode": "service unavailable",
        "healthy": False,
        "capabilities": [],
        "safety": {"mutations": "disabled", "telemetry": "disabled"},
    }


class Metric(Gtk.Box):
    def __init__(self, icon: str, label: str, value: str, detail: str, color: str):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        self.add_css_class("metric")
        glyph = Gtk.Label(label=icon)
        glyph.add_css_class("metric-icon")
        glyph.add_css_class(color)
        self.append(glyph)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        caption = Gtk.Label(label=label, xalign=0)
        caption.add_css_class("caption")
        main = Gtk.Label(label=value, xalign=0)
        main.add_css_class("metric-value")
        sub = Gtk.Label(label=detail, xalign=0)
        sub.add_css_class("detail")
        text.append(caption)
        text.append(main)
        text.append(sub)
        self.append(text)


class ForgeHub(Gtk.ApplicationWindow):
    def __init__(self, app: Gtk.Application):
        super().__init__(application=app, title="Forge Hub")
        self.set_default_size(1440, 900)
        self.set_size_request(980, 650)
        self.status = daemon_status()

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.set_child(root)
        root.append(self.build_sidebar())

        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.content.set_hexpand(True)
        root.append(self.content)
        self.content.append(self.build_header())

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        self.stack.set_margin_start(34)
        self.stack.set_margin_end(34)
        self.stack.set_margin_bottom(32)
        self.content.append(self.stack)
        self.stack.add_named(self.build_overview(), "overview")
        self.stack.add_named(self.build_message("Workspaces", "Reproducible project environments arrive after the authorization and rollback gates."), "workspaces")
        self.stack.add_named(self.build_message("Updates", "Package plans will create a recovery point and verify health before commit."), "updates")
        self.stack.add_named(self.build_message("Recovery", "Snapshot inspection is designed, but mutations remain disabled in milestone zero."), "recovery")

    def build_sidebar(self) -> Gtk.Box:
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        side.add_css_class("sidebar")
        side.set_size_request(220, -1)
        brand = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        brand.set_margin_bottom(24)
        mark = Gtk.Label(label="F")
        mark.add_css_class("brand-mark")
        name = Gtk.Label(label="ForgeOS")
        name.add_css_class("brand-name")
        brand.append(mark)
        brand.append(name)
        side.append(brand)

        group = None
        for name, icon, key in [
            ("Overview", "▦", "overview"),
            ("Workspaces", "⌘", "workspaces"),
            ("Updates", "↻", "updates"),
            ("Recovery", "◇", "recovery"),
        ]:
            button = Gtk.ToggleButton(label=f"{icon}   {name}")
            button.add_css_class("nav-button")
            if group is not None:
                button.set_group(group)
            else:
                group = button
                button.set_active(True)
            button.connect("toggled", self.change_view, key)
            side.append(button)

        spacer = Gtk.Box()
        spacer.set_vexpand(True)
        side.append(spacer)
        local = Gtk.Label(label="●  Local only\nNo telemetry", xalign=0)
        local.add_css_class("local-state")
        side.append(local)
        return side

    def change_view(self, button: Gtk.ToggleButton, key: str):
        if button.get_active() and hasattr(self, "stack"):
            self.stack.set_visible_child_name(key)
            self.title_label.set_text({"overview": "System overview", "workspaces": "Workspaces", "updates": "System updates", "recovery": "Recovery"}[key])

    def build_header(self) -> Gtk.Box:
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        header.add_css_class("header")
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        eyebrow = Gtk.Label(label="MILESTONE ZERO", xalign=0)
        eyebrow.add_css_class("eyebrow")
        self.title_label = Gtk.Label(label="System overview", xalign=0)
        self.title_label.add_css_class("window-title")
        title_box.append(eyebrow)
        title_box.append(self.title_label)
        header.append(title_box)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        header.append(spacer)
        healthy = bool(self.status.get("healthy"))
        badge = Gtk.Label(label=("●  System healthy" if healthy else "●  Service offline"))
        badge.add_css_class("health-badge")
        badge.add_css_class("healthy" if healthy else "offline")
        header.append(badge)
        return header

    def build_overview(self) -> Gtk.ScrolledWindow:
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        page.set_margin_top(24)
        scroll.set_child(page)

        hero = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=20)
        hero.add_css_class("hero")
        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        copy.set_hexpand(True)
        tag = Gtk.Label(label="FORGEOS 0.1 DEV", xalign=0)
        tag.add_css_class("tag")
        headline = Gtk.Label(label="Your development system\nis ready to build", xalign=0)
        headline.add_css_class("hero-title")
        body = Gtk.Label(label="A complete Debian-based desktop foundation with a native control plane, reproducible image build, and recovery-first boundaries.", xalign=0, wrap=True)
        body.add_css_class("hero-copy")
        copy.append(tag)
        copy.append(headline)
        copy.append(body)
        hero.append(copy)
        emblem = Gtk.Label(label="F")
        emblem.add_css_class("hero-emblem")
        hero.append(emblem)
        page.append(hero)

        metrics = Gtk.Grid(column_spacing=14, row_spacing=14)
        metrics.set_column_homogeneous(True)
        metrics.attach(Metric("⌁", "SYSTEM STATE", "Healthy" if self.status.get("healthy") else "Offline", "Core service status", "teal"), 0, 0, 1, 1)
        metrics.attach(Metric("▣", "WORKSPACES", "Foundation", "Podman installed", "blue"), 1, 0, 1, 1)
        metrics.attach(Metric("◇", "RECOVERY", "Guarded", "Mutations disabled", "purple"), 2, 0, 1, 1)
        metrics.attach(Metric("↻", "UPDATES", "Planned", "Transactional gate", "amber"), 3, 0, 1, 1)
        page.append(metrics)

        lower = Gtk.Grid(column_spacing=18, row_spacing=18)
        lower.set_column_homogeneous(True)
        lower.attach(self.build_foundation_panel(), 0, 0, 2, 1)
        lower.attach(self.build_safety_panel(), 2, 0, 1, 1)
        page.append(lower)
        return scroll

    def panel(self, title: str, subtitle: str) -> tuple[Gtk.Box, Gtk.Box]:
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        frame.add_css_class("panel")
        eye = Gtk.Label(label=subtitle, xalign=0)
        eye.add_css_class("eyebrow")
        heading = Gtk.Label(label=title, xalign=0)
        heading.add_css_class("panel-title")
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        frame.append(eye)
        frame.append(heading)
        frame.append(body)
        return frame, body

    def build_foundation_panel(self) -> Gtk.Box:
        frame, body = self.panel("Operating system foundation", "REAL IMAGE CONTENTS")
        rows = [
            ("Debian 13", "Stable package and security base", "Ready"),
            ("KDE Plasma", "Wayland desktop and system settings", "Ready"),
            ("Podman", "Rootless development containers", "Installed"),
            ("Calamares", "Graphical disk installer", "Included"),
        ]
        for title, detail, state in rows:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            row.add_css_class("list-row")
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            text.set_hexpand(True)
            text.append(Gtk.Label(label=title, xalign=0, css_classes=["row-title"]))
            text.append(Gtk.Label(label=detail, xalign=0, css_classes=["detail"]))
            row.append(text)
            row.append(Gtk.Label(label=state, css_classes=["state-pill"]))
            body.append(row)
        return frame

    def build_safety_panel(self) -> Gtk.Box:
        frame, body = self.panel("Safety boundaries", "HONEST BY DEFAULT")
        messages = [
            "No telemetry or cloud account",
            "Privileged mutations disabled",
            "Unix socket API is versioned",
            "Systemd service is sandboxed",
            "Snapshots are not called backups",
        ]
        for message in messages:
            label = Gtk.Label(label=f"✓  {message}", xalign=0, wrap=True)
            label.add_css_class("check-row")
            body.append(label)
        return frame

    def build_message(self, title: str, message: str) -> Gtk.Box:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        page.set_halign(Gtk.Align.CENTER)
        page.set_valign(Gtk.Align.CENTER)
        icon = Gtk.Label(label="◇")
        icon.add_css_class("empty-icon")
        heading = Gtk.Label(label=title)
        heading.add_css_class("empty-title")
        copy = Gtk.Label(label=message, wrap=True, justify=Gtk.Justification.CENTER)
        copy.set_max_width_chars(60)
        copy.add_css_class("empty-copy")
        page.append(icon)
        page.append(heading)
        page.append(copy)
        return page


class ForgeApplication(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.forgeos.Hub", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        try:
            provider.load_from_path(CSS_PATH)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except GLib.Error:
            pass

    def do_activate(self):
        window = self.props.active_window
        if not window:
            window = ForgeHub(self)
        window.present()


if __name__ == "__main__":
    raise SystemExit(ForgeApplication().run())
