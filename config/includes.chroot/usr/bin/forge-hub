#!/usr/bin/python3
from __future__ import annotations

import json
import os
import shutil
import socket
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango


SOCKET_PATH = "/run/forgeos/forged.sock"
API_VERSION = "forgeos.dev/v1"
CSS_PATH = "/usr/share/forgeos/forge-hub.css"


def daemon_status() -> dict:
    request = {"version": API_VERSION, "action": "status.read"}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(1.5)
            client.connect(SOCKET_PATH)
            client.sendall((json.dumps(request) + "\n").encode())
            response = b""
            while not response.endswith(b"\n") and len(response) < 65536:
                part = client.recv(4096)
                if not part:
                    break
                response += part
        payload = json.loads(response.decode())
        if payload.get("ok"):
            return payload["data"]
    except (OSError, ValueError, KeyError):
        pass
    return {"healthy": False, "release": "0.1-dev", "capabilities": []}


def host_metrics() -> tuple[int, int, int]:
    cores = max(os.cpu_count() or 1, 1)
    try:
        cpu = min(100, round((os.getloadavg()[0] / cores) * 100))
    except OSError:
        cpu = 0

    values: dict[str, int] = {}
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            key, value = line.split(":", 1)
            values[key] = int(value.strip().split()[0])
        total = values.get("MemTotal", 1)
        available = values.get("MemAvailable", total)
        ram = round(((total - available) / total) * 100)
    except (OSError, ValueError, ZeroDivisionError):
        ram = 0

    disk = shutil.disk_usage("/")
    used = round(((disk.total - disk.free) / disk.total) * 100) if disk.total else 0
    return cpu, ram, used


def workspace_count() -> int:
    root = Path.home() / "workspaces"
    try:
        return sum(1 for item in root.iterdir() if item.is_dir())
    except OSError:
        return 0


class StatusCard(Gtk.Box):
    def __init__(self, icon: str, title: str, detail: str, color: str):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        self.add_css_class("status-card")

        glyph = Gtk.Label(label=icon)
        glyph.add_css_class("card-icon")
        glyph.add_css_class(color)
        self.append(glyph)

        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        copy.set_hexpand(True)
        self.title = Gtk.Label(label=title, xalign=0)
        self.title.add_css_class("card-title")
        self.detail = Gtk.Label(label=detail, xalign=0)
        self.detail.set_ellipsize(Pango.EllipsizeMode.END)
        self.detail.add_css_class("card-detail")
        copy.append(self.title)
        copy.append(self.detail)
        self.append(copy)

        arrow = Gtk.Label(label="›")
        arrow.add_css_class("card-arrow")
        self.append(arrow)

    def set_copy(self, title: str, detail: str):
        self.title.set_text(title)
        self.detail.set_text(detail)


class ForgeHub(Gtk.ApplicationWindow):
    def __init__(self, app: Gtk.Application):
        super().__init__(application=app, title="Forge Hub")
        self.set_default_size(468, 650)
        self.set_size_request(420, 590)
        self.set_resizable(False)
        self.set_decorated(False)
        self.add_css_class("forge-window")

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.add_css_class("hub-root")
        self.set_child(root)
        root.append(self.build_header())

        cards = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        cards.add_css_class("cards")
        root.append(cards)

        self.system_card = StatusCard("⌁", "Checking system", "Connecting to forged …", "teal")
        cards.append(self.system_card)

        snapshot_present = Path("/.snapshots").exists()
        cards.append(StatusCard(
            "◇",
            "Snapshot protected" if snapshot_present else "Recovery guarded",
            "Btrfs snapshots detected" if snapshot_present else "Snapshot mutations stay disabled",
            "purple",
        ))

        count = workspace_count()
        cards.append(StatusCard(
            "▱",
            f"{count} workspace{'s' if count != 1 else ''}",
            "~/workspaces · Podman foundation ready",
            "teal",
        ))

        cards.append(StatusCard(
            "⇩",
            "Updates planned",
            "Transactional update gate is not enabled",
            "amber",
        ))

        divider = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        divider.add_css_class("divider")
        root.append(divider)
        root.append(self.build_modes())

        footer = Gtk.Label(label="LOCAL FIRST  ·  NO TELEMETRY")
        footer.add_css_class("footer")
        root.append(footer)

        self.refresh_status()
        GLib.timeout_add_seconds(5, self.refresh_status)

    def build_header(self) -> Gtk.Box:
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        header.add_css_class("hub-header")

        logo = Gtk.Image.new_from_icon_name("forgeos")
        logo.set_pixel_size(48)
        logo.add_css_class("hub-logo")
        header.append(logo)

        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        copy.set_hexpand(True)
        title = Gtk.Label(label="Forge Hub", xalign=0)
        title.add_css_class("hub-title")
        subtitle = Gtk.Label(label="Your ForgeOS control surface", xalign=0)
        subtitle.add_css_class("hub-subtitle")
        copy.append(title)
        copy.append(subtitle)
        header.append(copy)

        close = Gtk.Button(label="×")
        close.add_css_class("close-button")
        close.set_tooltip_text("Close Forge Hub")
        close.connect("clicked", lambda _button: self.close())
        header.append(close)
        return header

    def build_modes(self) -> Gtk.Box:
        section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        section.add_css_class("mode-section")
        label = Gtk.Label(label="Workspace Mode", xalign=0)
        label.add_css_class("mode-label")
        section.append(label)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.set_homogeneous(True)
        for glyph, label_text, enabled in [
            ("‹/›", "CODE", True),
            ("△", "TEST", False),
            ("↗", "SHIP", False),
        ]:
            button = Gtk.Button(label=f"{glyph}   {label_text}")
            button.add_css_class("mode-button")
            if enabled:
                button.add_css_class("selected")
            else:
                button.set_sensitive(False)
                button.set_tooltip_text(f"{label_text.title()} mode arrives after milestone zero")
            row.append(button)
        section.append(row)
        return section

    def refresh_status(self) -> bool:
        status = daemon_status()
        cpu, ram, disk = host_metrics()
        healthy = bool(status.get("healthy"))
        self.system_card.set_copy(
            "System healthy" if healthy else "Service offline",
            f"CPU {cpu}%  ·  RAM {ram}%  ·  Disk {disk}%",
        )
        self.system_card.remove_css_class("offline-card")
        if not healthy:
            self.system_card.add_css_class("offline-card")
        return GLib.SOURCE_CONTINUE


class ForgeApplication(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.forgeos.Hub", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        try:
            provider.load_from_path(CSS_PATH)
            display = Gdk.Display.get_default()
            if display:
                Gtk.StyleContext.add_provider_for_display(
                    display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
                )
        except GLib.Error:
            pass

    def do_activate(self):
        window = self.props.active_window
        if not window:
            window = ForgeHub(self)
        window.present()


if __name__ == "__main__":
    raise SystemExit(ForgeApplication().run())
